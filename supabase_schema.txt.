create or replace function public.admin_approve_membership(payment_id uuid)
returns void
language plpgsql
security definer
set search_path = ''
as $$
declare
  pay_rec record;
  referrer uuid;
  ref_bonus numeric := 5.00;
begin
  if auth.uid() is null or not public.is_admin(auth.uid()) then
    raise exception 'Unauthorized: Admin access required.';
  end if;

  select * into pay_rec from public.membership_payments where id = payment_id and status = 'pending' for update;
  if not found then
    raise exception 'Payment not found or already processed.';
  end if;

  update public.membership_payments set status = 'approved' where id = payment_id;
  update public.profiles set membership_status = 'active' where id = pay_rec.user_id;

  select referred_by into referrer from public.profiles where id = pay_rec.user_id;
  if referrer is not null then
    perform 1 from public.profiles where id = referrer for update;
    update public.profiles set referral_count = referral_count + 1 where id = referrer;
    update public.profiles set reward_balance = reward_balance + ref_bonus where id = referrer;
    
    insert into public.reward_ledger (user_id, amount, description)
    values (referrer, ref_bonus, 'Referral bonus awarded for verified member payment');
  end if;
end;
$$;

create or replace function public.admin_approve_submission(sub_id uuid)
returns void
language plpgsql
security definer
set search_path = ''
as $$
declare
  sub_rec record;
  act_rec record;
begin
  if auth.uid() is null or not public.is_admin(auth.uid()) then
    raise exception 'Unauthorized: Admin access required.';
  end if;

  select * into sub_rec from public.activity_submissions where id = sub_id and status = 'pending' for update;
  if not found then
    raise exception 'Submission not found or already reviewed.';
  end if;

  select * into act_rec from public.activities where id = sub_rec.activity_id;
  if not found then
    raise exception 'Activity not found.';
  end if;

  if sub_rec.user_id = auth.uid() then
    raise exception 'Administrators cannot approve their own submissions.';
  end if;

  update public.activity_submissions set status = 'approved' where id = sub_id;

  perform 1 from public.profiles where id = sub_rec.user_id for update;
  update public.profiles 
  set reward_balance = reward_balance + act_rec.reward_amount 
  where id = sub_rec.user_id;

  insert into public.reward_ledger (user_id, amount, description)
  values (sub_rec.user_id, act_rec.reward_amount, 'Activity reward approved: ' || act_rec.title);
end;
$$;

create or replace function public.admin_reject_submission(sub_id uuid)
returns void
language plpgsql
security definer
set search_path = ''
as $$
begin
  if auth.uid() is null or not public.is_admin(auth.uid()) then
    raise exception 'Unauthorized: Admin access required.';
  end if;

  update public.activity_submissions set status = 'rejected' where id = sub_id and status = 'pending';
end;
$$;

create or replace function public.member_request_withdrawal(req_amount numeric)
returns void
language plpgsql
security definer
set search_path = ''
as $$
declare
  current_bal numeric;
  min_wd numeric;
begin
  if auth.uid() is null then
    raise exception 'Authentication required.';
  end if;

  if req_amount <= 0 then
    raise exception 'Invalid withdrawal amount.';
  end if;

  select coalesce(value::numeric, 10.00) into min_wd from public.website_settings where key = 'min_withdrawal';
  if req_amount < min_wd then
    raise exception 'Withdrawal amount is less than the minimum required ($%).', min_wd;
  end if;

  select reward_balance into current_bal from public.profiles where id = auth.uid() for update;
  if current_bal < req_amount then
    raise exception 'Insufficient reward balance.';
  end if;

  update public.profiles set reward_balance = reward_balance - req_amount where id = auth.uid();

  insert into public.withdrawal_requests (user_id, amount, status)
  values (auth.uid(), req_amount, 'pending');

  insert into public.reward_ledger (user_id, amount, description)
  values (auth.uid(), -req_amount, 'Withdrawal request submitted (pending payout)');
end;
$$;

create or replace function public.admin_approve_withdrawal(wd_id uuid)
returns void
language plpgsql
security definer
set search_path = ''
as $$
begin
  if auth.uid() is null or not public.is_admin(auth.uid()) then
    raise exception 'Unauthorized: Admin access required.';
  end if;

  update public.withdrawal_requests set status = 'paid' where id = wd_id and status = 'pending';
  if not found then
    raise exception 'Withdrawal request not found or already processed.';
  end if;
end;
$$;

create or replace function public.admin_reject_withdrawal(wd_id uuid)
returns void
language plpgsql
security definer
set search_path = ''
as $$
declare
  wd_rec record;
begin
  if auth.uid() is null or not public.is_admin(auth.uid()) then
    raise exception 'Unauthorized: Admin access required.';
  end if;

  select * into wd_rec from public.withdrawal_requests where id = wd_id and status = 'pending' for update;
  if not found then
    raise exception 'Withdrawal request not found or already processed.';
  end if;

  update public.withdrawal_requests set status = 'rejected' where id = wd_id;

  perform 1 from public.profiles where id = wd_rec.user_id for update;
  update public.profiles set reward_balance = reward_balance + wd_rec.amount where id = wd_rec.user_id;

  insert into public.reward_ledger (user_id, amount, description)
  values (wd_rec.user_id, wd_rec.amount, 'Withdrawal request rejected - funds refunded');
end;
$$;

