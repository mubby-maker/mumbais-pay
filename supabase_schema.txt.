revoke execute on function public.is_admin(uuid) from public, anon;
grant execute on function public.is_admin(uuid) to authenticated, service_role;

revoke execute on function public.enforce_profile_update_restrictions() from public, anon;
grant execute on function public.enforce_profile_update_restrictions() to authenticated, service_role;

revoke execute on function public.handle_new_user() from public, anon;
grant execute on function public.handle_new_user() to service_role;

revoke execute on function public.admin_approve_membership(uuid) from public, anon;
grant execute on function public.admin_approve_membership(uuid) to authenticated;

revoke execute on function public.admin_approve_submission(uuid) from public, anon;
grant execute on function public.admin_approve_submission(uuid) to authenticated;

revoke execute on function public.admin_reject_submission(uuid) from public, anon;
grant execute on function public.admin_reject_submission(uuid) to authenticated;

revoke execute on function public.member_request_withdrawal(numeric) from public, anon;
grant execute on function public.member_request_withdrawal(numeric) to authenticated;

revoke execute on function public.admin_approve_withdrawal(uuid) from public, anon;
grant execute on function public.admin_approve_withdrawal(uuid) to authenticated;

revoke execute on function public.admin_reject_withdrawal(uuid) from public, anon;
grant execute on function public.admin_reject_withdrawal(uuid) to authenticated;

