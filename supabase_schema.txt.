-- ==============================================================================
-- SECURITY DEFINER HELPER FUNCTIONS
-- ==============================================================================

create or replace function public.is_admin(check_user_id uuid)
returns boolean
language sql
security definer
set search_path = ''
stable
as $$
  select exists (
    select 1 from public.admin_roles where admin_roles.user_id = check_user_id
  );
$$;

create or replace function public.enforce_profile_update_restrictions()
returns trigger
language plpgsql
security definer
set search_path = ''
as $$
begin
  if public.is_admin(auth.uid()) then
    return new;
  end if;

  if new.membership_status is distinct from old.membership_status then
    raise exception 'Unauthorized: Members cannot change their membership status.';
  end if;
  if new.reward_balance is distinct from old.reward_balance then
    raise exception 'Unauthorized: Members cannot change their reward balance.';
  end if;
  if new.referral_count is distinct from old.referral_count then
    raise exception 'Unauthorized: Members cannot change their referral count.';
  end if;
  if new.referral_code is distinct from old.referral_code then
    raise exception 'Unauthorized: Members cannot change their referral code.';
  end if;

  return new;
end;
$$;

drop trigger if exists enforce_profile_updates on public.profiles;
create trigger enforce_profile_updates
  before update on public.profiles
  for each row execute function public.enforce_profile_update_restrictions();

create or replace function public.handle_new_user()
returns trigger
language plpgsql
security definer
set search_path = ''
as $$
declare
  generated_code text;
  ref_code_input text;
  ref_by uuid := null;
begin
  generated_code := upper(substring(md5(random()::text || clock_timestamp()::text) from 1 for 8));
  
  begin
    ref_code_input := nullif(trim(new.raw_user_meta_data->>'referral_code'), '');
    if ref_code_input is not null then
      select id into ref_by from public.profiles where referral_code = ref_code_input;
      if ref_by = new.id then
        ref_by := null;
      end if;
    end if;
  exception when others then
    ref_by := null;
  end;

  insert into public.profiles (id, full_name, email, membership_status, reward_balance, referral_code, referred_by)
  values (
    new.id,
    coalesce(new.raw_user_meta_data->>'full_name', 'New Member'),
    new.email,
    'pending',
    0.00,
    generated_code,
    ref_by
  );
  return new;
end;
$$;

drop trigger if exists on_auth_user_created on auth.users;
create trigger on_auth_user_created
  after insert on auth.users
  for each row execute procedure public.handle_new_user();

